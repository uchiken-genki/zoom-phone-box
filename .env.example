# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom Marketplace の Event Subscriptions に表示される Secret Token
ZOOM_WEBHOOK_SECRET_TOKEN=

# Box Platform アプリ（Client Credentials Grant）
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# 保存先の親フォルダ。0 はサービスアカウントのルート
BOX_PARENT_FOLDER_ID=0
BOX_ROOT_FOLDER_NAME=Zoom

APP_HOST=0.0.0.0
APP_PORT=8787
# Zoom から到達できる公開 URL。ローカル検証時は ngrok などの HTTPS URL
PUBLIC_BASE_URL=http://localhost:8787
